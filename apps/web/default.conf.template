# One origin serves the SPA and proxies the JSON API, so session cookies and CSRF stay same-origin.
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

# Phoenix redirects to HTTPS unless it sees the proxy's original scheme.
map $http_x_forwarded_proto $forwarded_proto {
  default $http_x_forwarded_proto;
  ''      $scheme;
}

server {
  listen 80;
  root /usr/share/nginx/html;

  # Image uploads are up to 25 MB plus form overhead.
  client_max_body_size 30m;

  # The nginx image fills NGINX_LOCAL_RESOLVERS from /etc/resolv.conf at start. A variable in
  # proxy_pass makes nginx resolve `api` again after the API restarts.
  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
  set $api http://api:4000;

  location ~ ^/(api|auth|rpc|socket)(/|$) {
    proxy_pass $api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    # Live editing keeps a WebSocket open.
    proxy_read_timeout 1h;
  }

  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  location / {
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}
