# Local docker compose only. Coolify generates the SERVICE_* values itself.
SERVICE_PASSWORD_POSTGRES=change-me-postgres
SERVICE_PASSWORD_64_SECRETKEYBASE=change-me-secret-key-base-change-me-secret-key-base-change-me-secret-key-base
SERVICE_PASSWORD_64_TOKENSIGNINGSECRET=change-me-token-signing-change-me-token-signing-change-me-token-signing
SERVICE_FQDN_WEB_80=localhost
SERVICE_URL_WEB_80=https://localhost

# Cloudflare R2 image storage. Compose requires a value. Local runs may keep the placeholders: only images need real ones.
R2_ACCOUNT_ID=placeholder
R2_BUCKET=placeholder
R2_ACCESS_KEY_ID=placeholder
R2_SECRET_ACCESS_KEY=placeholder

OPENROUTER_API_KEY=
