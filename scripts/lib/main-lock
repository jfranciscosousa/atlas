# Sourced by scripts/refresh-main and scripts/worktree-setup. The lock keeps two scripts from
# changing the main checkout at the same time.
# mkdir is the portable lock. shortcut: a killed script leaves a stale lock, delete $lock by hand.
lock="$main/.git/worktree-setup.lock"

acquire_lock() {
  local waited=0
  until mkdir "$lock" 2>/dev/null; do
    waited=$((waited + 1))
    ((waited > 300)) && return 1
    sleep 1
  done
  trap 'rmdir "$lock"' EXIT
}

release_lock() {
  rmdir "$lock" && trap - EXIT
}
