#!/usr/bin/env bash
# Prepare a new git worktree: refresh the main checkout (scripts/refresh-main), copy its built
# dependencies, install, and create the worktree's own database. T3 Code runs this on worktree
# creation. Safe to run again, also from an agent.
set -euo pipefail

worktree=$(git rev-parse --show-toplevel)
main=$(git worktree list --porcelain | sed -n '1s/^worktree //p')
here=$(cd "$(dirname "$0")" && pwd)
# shellcheck source=lib/main-lock
source "$here/lib/main-lock"

warn() { echo "worktree-setup: $*" >&2; }

copy_from_main() {
  local dir
  for dir in deps _build; do
    [[ -d "$main/apps/api/$dir" && ! -e "$worktree/apps/api/$dir" ]] \
      && cp -a "$main/apps/api/$dir" "$worktree/apps/api/$dir"
  done
  return 0
}

if [[ "$main" != "$worktree" ]]; then
  if acquire_lock; then
    # Refresh first, so the copy holds current builds. --skip-refresh copies what main has.
    [[ ${1:-} == --skip-refresh ]] || (ATLAS_MAIN_LOCKED=1 "$here/refresh-main") || true
    copy_from_main
    release_lock
  else
    warn "main is locked by another setup, skipping the copy"
  fi
fi

cd "$worktree"
pnpm install --frozen-lockfile --prefer-offline
cd apps/api
mix setup
mix atlas.dev_user
mix compile

db=$(elixir -e 'IO.puts(elem(Code.eval_file("config/worktree.exs"), 0))')
echo "worktree-setup: done. Dev database: atlas_dev$db, test database: atlas_test$db"
