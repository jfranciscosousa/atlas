# Docker's Dockerfile-specific ignore file REPLACES the root .dockerignore.
# Allow only combined-build inputs, not the standalone web-only context's rules.
**
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!scripts/
!scripts/check-package-manager.cjs
!apps/
!apps/api/
!apps/api/mix.exs
!apps/api/mix.lock
!apps/api/config/
!apps/api/config/config.exs
!apps/api/config/prod.exs
!apps/api/config/runtime.exs
!apps/api/lib/
!apps/api/lib/**
!apps/api/priv/
!apps/api/priv/**
!apps/web/
!apps/web/package.json
!apps/web/vite.config.ts
!apps/web/tsconfig.json
!apps/web/components.json
!apps/web/src/
!apps/web/src/**
!apps/web/public/
!apps/web/public/**
!packages/
!packages/api-client/
!packages/api-client/package.json
!packages/api-client/src/
!packages/api-client/src/**
!deploy/
!deploy/entrypoint
!deploy/publish-assets
# Defense in depth, including any accidentally nested build inputs.
**/.git
**/.env
**/.env.*
**/*.pem
**/*.key
**/node_modules
**/dist
**/.tanstack
**/_build
**/deps
**/tmp
**/erl_crash.dump
